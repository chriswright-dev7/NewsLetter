# Newsletter server port (the Vite dev server proxies /api to it)
PORT=5100

# Where articles, plans, users and sessions are stored (default: data/db.json)
# DATA_FILE=data/db.json

# How long a login lasts, in days
SESSION_DAYS=30

# List the seeded demo accounts (password "demo") on the login page
SHOW_DEMO_ACCOUNTS=true
